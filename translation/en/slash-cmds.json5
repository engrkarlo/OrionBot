// English Translation (en) by NooberPro

{
  // Translation for the slash commands.

  // The name field is the command name. You can rename the command name, but it CANNOT BE TRANSLATED.
  // The description field provides the description of the command.
  help: {
    name: 'help',
    description: 'Sends the list of available commands.',
    options: {
      name: 'command',
      description: 'Sends the details about a command.',
    },
  },
  ip: {
    name: 'ip',
    description: 'Sends the server address of the Minecraft server.',
  },
  site: {
    name: 'site',
    description: 'Sends the website/vote link of the Minecraft server.',
  },
  version: {
    name: 'version',
    description: 'Sends the version of the Minecraft server.',
  },

  // The errorReply field is used if there is an error while executing the command, and it replies with an errorReply message.
  motd: {
    name: 'motd',
    description: "Sends the Minecraft Server's Message of the Day (MOTD).",
    errorReply: ':warning:  **`An error occurred while retrieving the Message of the Day (MOTD).`**',
  },
  players: {
    name: 'players',
    description: 'Sends the list of players who are currently online on the Minecraft server.',
    errorReply: ':warning:  **`An error occurred while retrieving the online players list.`**',
  },
  status: {
    name: 'status',
    description: 'Sends the current status of the Minecraft server.',
    errorReply: ':warning:  **`Unable to find the status of the server due to an error.`**',
  },
  info: {
    name: 'info',
    description: 'Sends the current information about the bot.',
    errorReply: ':warning:  **`An error occurred while retrieving Info.`**',
  },
  setstatus: {
    name: 'setstatus',
    description: 'Sets the status message of the Minecraft server in the current channel.',
    serverName: 'Enter the name of your Minecraft server.',
    serverIp: 'Enter the IP address of your Minecraft server.',
    serverPort: 'Enter the port number of your Minecraft server.',
    serverType: 'Choose your server type: Java or Bedrock',
    playerAvatar: 'Option for ADMINS to display player avatars alongside the player list.',
    // Use {error} to receive the error message.
    errorReply: ':warning:  **`Could not set the status message due to an error: {error}.`**',
    enableFeature: '**Please enable `auto Change Status` in the config to enable the status message feature.**',
    checkingStatusMsg: ':gear: Checking the status...',
    checkingStatusCmdMsg: ':arrows_clockwise: Checking the status and necessary info.',
    // Use {channel} to provide the channel link, and {messageLink} provides the message link icon.
    statusMsgSuccess: ':white_check_mark: **Status message is set successfully in {channel}. Message:** {messageLink}.',
  },
  setup: {
    name: 'setup',
    description: 'Configure or view the Minecraft server this bot monitors.',
    subServer: {
      name: 'server',
      description: 'Set the Minecraft server this bot monitors.',
    },
    subView: {
      name: 'view',
      description: 'View the currently active server configuration.',
    },
    subReset: {
      name: 'reset',
      description: 'Clear the saved server override and revert to config.js defaults.',
    },
    subIcon: {
      name: 'icon',
      description: 'Set a custom icon URL shown as thumbnail in all server embeds.',
    },
    optionIconUrl: 'Direct URL to an image (PNG, JPG, GIF). Used as the thumbnail in all server embeds.',
    optionIp: 'IP address of the Minecraft server.',
    optionType: 'Server type: Java or Bedrock.',
    optionPort: 'Port number (defaults to 25565 for Java, 19132 for Bedrock).',
    optionName: 'Display name for the server (defaults to the IP).',
    optionVersion: 'Version label shown in commands (e.g. 1.8 - 1.20).',
    successTitle: ':white_check_mark: Server configuration updated!',
    viewTitle: ':mag: Active Server Configuration',
    viewDescSaved: 'This configuration was set via `/setup server` and persists across restarts.',
    viewDescDefault: 'This is the default configuration from `config.js`. Use `/setup server` to override it.',
    fieldName: 'Name',
    fieldIp: 'IP',
    fieldPort: 'Port',
    fieldType: 'Type',
    fieldVersion: 'Version',
    resetSuccess: ':white_check_mark: **Server config reset. Now using the defaults from `config.js`.**',
    resetNoop: ':information_source: **No saved override found — already using `config.js` defaults.**',
    iconSuccessTitle: ':frame_photo: Server icon updated!',
    iconSuccessDesc: 'The new icon is shown below. It will appear as the thumbnail in status, players, and motd embeds immediately.',
    iconInvalidUrl: ':warning: **`Invalid URL. Please provide a direct link ending in .png, .jpg, .gif, or .webp.`**',
    // Use {ip} to receive the given IP.
    invalidIp: ':warning: **`Invalid IP address: {ip}`**',
    // Use {error} to receive the error message.
    errorReply: ':warning: **`Could not update server config: {error}`**',
  },
  away: {
    name: 'away',
    description: "Mark yourself as away with a reason. Use it again while away to turn it off.",
    modalTitle: 'Set your away status',
    modalLabel: 'Reason (optional)',
    modalPlaceholder: 'e.g. In a meeting, back in an hour',
    // Use {reason} to receive the reason the user entered in the form.
    turnedOn: ":wave: **You're now marked as away.**\n**Reason:** {reason}",
    turnedOnNoReason: ":wave: **You're now marked as away.**",
    turnedOff: ":white_check_mark: **You're no longer marked as away.** Welcome back!",
    enableFeature: '**Please enable `away` in the config to use this command.**',
    guildOnly: ':warning: **`This command can only be used inside a server.`**',
    errorReply: ':warning: **`Could not update your away status due to an error.`**',
  },
  disabledChannelMsg: ':no_entry: Commands are disabled in this channel.',
}
