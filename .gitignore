# Local secrets and environment-specific configuration
.env
.env.*
!.env.example

# Dependencies and runtime output
node_modules/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Bot-generated runtime data
# Keep the directory in Git, but never commit generated saved messages, triggers, or other runtime state.
data/*
!data/.gitkeep
